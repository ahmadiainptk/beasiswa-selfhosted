---
// path: src/pages/index.astro
import PublicLayout from "../layouts/PublicLayout.astro";

import { drizzle } from "drizzle-orm/d1";
import { eq, desc } from "drizzle-orm";
import * as schema from "../db/schema";
import {
  sessions,
  users,
  beasiswa as beasiswaTable,
  blogPosts,
  blogCategories,
  blogTags,
  blogPostTags,
} from "../db/schema";
import { getCookieName } from "../lib/auth";

// Check if already logged in
let isLoggedIn = false;
let userRole = "";

try {
  const token = Astro.cookies.get(getCookieName())?.value;
  if (token && Astro.locals.runtime.env?.DB) {
    const db = drizzle(Astro.locals.runtime.env?.DB, { schema });
    const session = await db
      .select()
      .from(sessions)
      .innerJoin(users, eq(sessions.userId, users.id))
      .where(eq(sessions.token, token))
      .limit(1);

    if (
      session.length > 0 &&
      new Date(session[0].sessions.expiresAt) > new Date()
    ) {
      isLoggedIn = true;
      userRole = session[0].users.role;
    }
  }
} catch (e) {}

// Get available beasiswa
let beasiswaList: any[] = [];
try {
  if (Astro.locals.runtime.env?.DB) {
    const db = drizzle(Astro.locals.runtime.env.DB, { schema });
    beasiswaList = await db
      .select()
      .from(beasiswaTable)
      .where(eq(beasiswaTable.aktif, 1));
  }
} catch (e) {}

// Get recent blog posts
let recentPosts: any[] = [];
try {
  if (Astro.locals.runtime.env?.DB) {
    const db = drizzle(Astro.locals.runtime.env.DB, { schema });
    const rawPosts = await db
      .select({
        id: blogPosts.id,
        title: blogPosts.title,
        slug: blogPosts.slug,
        excerpt: blogPosts.excerpt,
        coverImage: blogPosts.coverImage,
        publishedAt: blogPosts.publishedAt,
        categoryName: blogCategories.name,
      })
      .from(blogPosts)
      .leftJoin(blogCategories, eq(blogPosts.categoryId, blogCategories.id))
      .where(eq(blogPosts.status, "published"))
      .orderBy(desc(blogPosts.publishedAt))
      .limit(4);

    recentPosts = await Promise.all(
      rawPosts.map(async (post) => {
        let tags: string[] = [];
        try {
          const tagRows = await db
            .select({ name: blogTags.name })
            .from(blogPostTags)
            .innerJoin(blogTags, eq(blogPostTags.tagId, blogTags.id))
            .where(eq(blogPostTags.postId, post.id));
          tags = tagRows.map((r: any) => r.name);
        } catch (e) {}
        return { ...post, tags };
      }),
    );
  }
} catch (e) {}
---

<PublicLayout title="Beranda">
  <!-- Hero Section -->
  <section
    class="relative min-h-[90vh] flex items-center overflow-hidden bg-surface-container-lowest"
  >
    <div class="absolute inset-0 bg-pattern"></div>
    <div
      class="absolute right-0 top-0 w-1/2 h-full hidden lg:flex items-center justify-center opacity-30 pointer-events-none"
    >
    </div>
    <div
      class="max-w-[1280px] mx-auto px-gutter grid lg:grid-cols-2 gap-stack-lg relative z-10 py-stack-lg"
    >
      <div class="flex flex-col justify-center space-y-stack-md">
        <span
          class="inline-block px-4 py-1 rounded-full bg-secondary-container text-on-secondary-container text-sm font-semibold tracking-wider uppercase w-fit"
        >
          Tahun Akademik 2026/2027
        </span>
        <h1
          class="text-[32px] md:text-[48px] font-bold font-[Montserrat] text-primary leading-tight tracking-tight"
        >
          Pendaftaran Beasiswa <br /><span class="text-secondary"
            >IAIN Pontianak</span
          >
        </h1>
        <p class="text-lg leading-relaxed text-on-surface-variant max-w-xl">
          Wujudkan impian akademik Anda melalui berbagai program beasiswa
          unggulan di Institut Agama Islam Negeri Pontianak. Kami berkomitmen
          mendukung talenta terbaik dan mahasiswa berprestasi.
        </p>
        <div class="flex flex-wrap gap-4 pt-stack-sm">
          <a
            href="/login"
            class="bg-primary text-on-primary px-8 py-4 rounded-full text-sm font-semibold tracking-wider flex items-center gap-2 hover:shadow-lg transition-all active:scale-95"
          >
            Lengkapi Datamu Sekarang
            <span class="material-symbols-outlined text-[20px]"
              >arrow_forward</span
            >
          </a>
          <a
            href="#"
            class="border-2 border-secondary text-secondary px-8 py-4 rounded-full text-sm font-semibold tracking-wider hover:bg-secondary-fixed transition-all active:scale-95"
          >
            Panduan Pendaftaran
          </a>
        </div>
      </div>
      <div class="relative hidden lg:flex items-center justify-center">
        <!-- SVG decorative background — IAIN geometric motif -->
        <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <radialGradient id="go1" cx="40%" cy="35%"><stop offset="0%" stop-color="#004d27" stop-opacity="0.12"/><stop offset="100%" stop-color="#004d27" stop-opacity="0"/></radialGradient>
            <radialGradient id="go2" cx="65%" cy="70%"><stop offset="0%" stop-color="#735c00" stop-opacity="0.08"/><stop offset="100%" stop-color="#735c00" stop-opacity="0"/></radialGradient>
            <radialGradient id="go3" cx="50%" cy="50%"><stop offset="0%" stop-color="#004d27" stop-opacity="0.04"/><stop offset="100%" stop-color="#f8f9fa" stop-opacity="0"/></radialGradient>
            <pattern id="dot" width="28" height="28" patternUnits="userSpaceOnUse"><circle cx="14" cy="14" r="0.7" fill="#004d27" opacity="0.08"/></pattern>
            <pattern id="dot2" width="56" height="56" patternUnits="userSpaceOnUse"><circle cx="28" cy="28" r="1" fill="#735c00" opacity="0.05"/></pattern>
          </defs>
          <!-- Background fill -->
          <rect width="600" height="600" fill="url(#go3)"/>
          <rect width="600" height="600" fill="url(#dot)"/>
          <rect width="600" height="600" fill="url(#dot2)"/>
          <!-- Large gradient orbs -->
          <circle cx="220" cy="180" r="180" fill="url(#go1)"/>
          <circle cx="400" cy="420" r="140" fill="url(#go2)"/>
          <!-- Concentric rings -->
          <circle cx="300" cy="300" r="280" fill="none" stroke="#004d27" stroke-width="0.3" opacity="0.12"/>
          <circle cx="300" cy="300" r="250" fill="none" stroke="#004d27" stroke-width="0.4" opacity="0.15"/>
          <circle cx="300" cy="300" r="210" fill="none" stroke="#735c00" stroke-width="0.3" opacity="0.10"/>
          <!-- 12-point geometric star -->
          <g transform="translate(300,300)" opacity="0.18">
            <polygon points="0,-270 72,-72 270,0 72,72 0,270 -72,72 -270,0 -72,-72" fill="none" stroke="#004d27" stroke-width="0.5"/>
            <polygon points="0,-240 64,-64 240,0 64,64 0,240 -64,64 -240,0 -64,-64" fill="none" stroke="#735c00" stroke-width="0.4"/>
            <polygon points="0,-180 48,-48 180,0 48,48 0,180 -48,48 -180,0 -48,-48" fill="none" stroke="#004d27" stroke-width="0.35"/>
            <polygon points="0,-110 30,-30 110,0 30,30 0,110 -30,30 -110,0 -30,-30" fill="none" stroke="#735c00" stroke-width="0.3"/>
            <circle cx="0" cy="0" r="45" fill="none" stroke="#004d27" stroke-width="0.4"/>
          </g>
          <!-- Diamond accents -->
          <g opacity="0.08">
            <rect x="80" y="420" width="24" height="24" fill="none" stroke="#004d27" stroke-width="0.6" transform="rotate(45 92 432)"/>
            <rect x="490" y="100" width="18" height="18" fill="none" stroke="#735c00" stroke-width="0.5" transform="rotate(45 499 109)"/>
            <rect x="450" y="500" width="16" height="16" fill="none" stroke="#004d27" stroke-width="0.4" transform="rotate(45 458 508)"/>
            <rect x="120" y="80" width="14" height="14" fill="none" stroke="#735c00" stroke-width="0.5" transform="rotate(45 127 87)"/>
          </g>
          <!-- Connecting arcs -->
          <path d="M 80 300 A 220 220 0 0 1 300 80" fill="none" stroke="#004d27" stroke-width="0.3" opacity="0.1"/>
          <path d="M 300 520 A 220 220 0 0 1 520 300" fill="none" stroke="#735c00" stroke-width="0.3" opacity="0.08"/>
          <path d="M 520 300 A 220 220 0 0 1 300 520" fill="none" stroke="#004d27" stroke-width="0.3" opacity="0.1"/>
          <path d="M 300 80 A 220 220 0 0 1 80 300" fill="none" stroke="#735c00" stroke-width="0.3" opacity="0.08"/>
        </svg>
        <img
          src="/mahasiswa-berprestasi.webp"
          alt="Mahasiswa berprestasi IAIN Pontianak"
          class="relative z-10 max-h-[400px] max-w-full object-contain"
        />
      </div>
    </div>
  </section>

  <!-- Active Beasiswa Section -->
  <section class="py-[80px] bg-surface">
    <div class="max-w-[1280px] mx-auto px-gutter">
      <div class="flex justify-between items-end mb-stack-lg">
        <div>
          <h2 class="text-[32px] font-semibold font-[Montserrat] text-primary">
            Program Beasiswa Aktif
          </h2>
          <p class="text-sm text-on-surface-variant">
            Pilih program yang sesuai dengan kualifikasi Anda
          </p>
        </div>
        <a
          href="/beasiswa"
          class="text-primary text-sm font-semibold tracking-wider flex items-center gap-1 hover:underline"
        >
          Lihat Semua Program
          <span class="material-symbols-outlined text-[18px]">open_in_new</span>
        </a>
      </div>

      {
        beasiswaList.length === 0 ? (
          <div class="text-center py-16 bg-white rounded-xl border border-outline-variant">
            <span class="material-symbols-outlined text-6xl text-outline-variant mb-4">
              school
            </span>
            <p class="text-on-surface-variant">
              Belum ada program beasiswa aktif
            </p>
          </div>
        ) : (
          <div class="grid md:grid-cols-2 gap-stack-lg">
            {beasiswaList.slice(0, 2).map((b) => {
              const now = new Date();
              const deadline = b.ditutupPada ? new Date(b.ditutupPada) : null;
              const isOpen =
                (!b.dibukaPada || new Date(b.dibukaPada) <= now) &&
                (!deadline || deadline >= now);
              const daysLeft = deadline
                ? Math.ceil(
                    (deadline.getTime() - now.getTime()) /
                      (1000 * 60 * 60 * 24),
                  )
                : null;

              return (
                <a href={`/beasiswa/${b.id}`} class="block bg-white p-8 rounded-xl border border-outline-variant hover:border-primary transition-all group relative overflow-hidden">
                  <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                    <span class="material-symbols-outlined text-[120px] text-secondary">
                      {isOpen ? "stars" : "schedule"}
                    </span>
                  </div>
                  <div class="flex flex-col h-full relative z-10">
                    <div class="flex justify-between items-start mb-6">
                      <span
                        class={`px-3 py-1 rounded-full text-[12px] font-bold uppercase tracking-wider ${isOpen ? "bg-primary-container text-on-primary-container" : "bg-surface-container-high text-on-surface-variant"}`}
                      >
                        {isOpen ? "Dibuka" : "Ditutup"}
                      </span>
                      {deadline && (
                        <div class="text-right">
                          <p class="text-sm font-semibold tracking-wider text-on-surface-variant">
                            Deadline
                          </p>
                          <p class="text-2xl font-semibold font-[Montserrat] text-error">
                            {deadline.toLocaleDateString("id-ID", {
                              day: "numeric",
                              month: "short",
                              year: "numeric",
                            })}
                          </p>
                        </div>
                      )}
                    </div>
                    <h3 class="text-2xl font-semibold font-[Montserrat] text-primary mb-4">
                      {b.nama}
                    </h3>
                    {b.deskripsi && (
                      <p class="text-sm text-on-surface-variant mb-8 flex-grow">
                        {b.deskripsi}
                      </p>
                    )}
                    <div class="flex items-center justify-between pt-6 border-t border-outline-variant">
                      <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-secondary">
                          timer
                        </span>
                        <span class="text-sm font-semibold tracking-wider text-secondary">
                          {isOpen
                            ? daysLeft !== null
                              ? `Sisa ${daysLeft} Hari Lagi`
                              : "Segera Dibuka"
                            : "Pendaftaran Ditutup"}
                        </span>
                      </div>
                      {isOpen && (
                        <a
                          href="/login"
                          class="bg-surface-container-high text-on-surface px-6 py-2 rounded-full text-sm font-semibold tracking-wider hover:bg-primary hover:text-on-primary transition-all"
                        >
                          Masuk / Daftar
                        </a>
                      )}
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        )
      }
    </div>
  </section>

  <!-- Berita Terbaru -->
  <section class="py-[80px] bg-surface-container-low">
    <div class="max-w-[1280px] mx-auto px-gutter">
      <div class="text-center mb-stack-lg">
        <h2
          class="text-[32px] font-semibold font-[Montserrat] text-primary mb-4"
        >
          Berita &amp; Informasi Terbaru
        </h2>
        <div class="w-24 h-1 bg-secondary mx-auto"></div>
      </div>

      {
        recentPosts.length === 0 ? (
          <div class="text-center py-16 bg-white rounded-xl border border-outline-variant">
            <span class="material-symbols-outlined text-6xl text-outline-variant mb-4">
              newspaper
            </span>
            <p class="text-on-surface-variant">Belum ada berita</p>
          </div>
        ) : (
          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-stack-md">
            {recentPosts.map((post) => (
              <a
                href={`/blog/${post.slug}`}
                class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow group"
              >
                <div class="h-48 relative bg-gradient-to-br from-primary/10 to-secondary/10">
                  {post.coverImage ? (
                    <img
                      src={post.coverImage}
                      alt={post.title}
                      class="w-full h-full object-cover"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center">
                      <span class="material-symbols-outlined text-5xl text-primary/20">
                        article
                      </span>
                    </div>
                  )}
                </div>
                <div class="p-stack-md">
                  <p class="text-xs text-on-surface-variant mb-2">
                    {post.publishedAt
                      ? new Date(post.publishedAt).toLocaleDateString("id-ID", {
                          day: "numeric",
                          month: "long",
                          year: "numeric",
                        })
                      : ""}
                  </p>
                  <h4 class="font-bold text-on-surface mb-2 line-clamp-2 leading-snug group-hover:text-primary transition-colors">
                    {post.title}
                  </h4>
                  {post.excerpt && (
                    <p class="text-sm text-on-surface-variant line-clamp-3 mb-4">
                      {post.excerpt}
                    </p>
                  )}
                  <span class="text-primary text-sm font-semibold tracking-wider hover:underline">
                    Baca Selengkapnya
                  </span>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- Alur Pendaftaran -->
  <section class="py-[80px] bg-surface">
    <div class="max-w-[1280px] mx-auto px-gutter">
      <h2
        class="text-[32px] font-semibold font-[Montserrat] text-primary mb-5 text-center"
      >
        Alur Pendaftaran
      </h2>
      <div class="bg-white rounded-xl p-6 border border-outline-variant">
        <div class="grid grid-cols-1 sm:grid-cols-5 gap-4">
          {
            [
              { icon: "edit_note", label: "Lengkapi Formulir" },
              { icon: "verified", label: "Menunggu Verifikasi Admin" },
              { icon: "school", label: "Pilih Beasiswa" },
              { icon: "newspaper", label: "Pengumuman Hasil Seleksi" },
            ].map((step) => (
              <div class="flex flex-col items-center text-center gap-2">
                <div class="w-12 h-12 rounded-full bg-primary-container flex items-center justify-center">
                  <span class="material-symbols-outlined text-on-primary-container text-xl">
                    {step.icon}
                  </span>
                </div>
                <span class="text-sm font-semibold tracking-wider text-on-surface-variant">
                  {step.label}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-[80px] bg-primary relative overflow-hidden">
    <div class="absolute inset-0 bg-pattern opacity-10"></div>
    <div class="max-w-[1280px] mx-auto px-gutter text-center relative z-10">
      <h2
        class="text-[32px] md:text-[48px] font-bold font-[Montserrat] text-on-primary mb-stack-md"
      >
        Siap Memulai Perjalanan Anda?
      </h2>
      <p
        class="text-lg leading-relaxed text-on-primary/80 max-w-2xl mx-auto mb-stack-lg"
      >
        Jangan lewatkan kesempatan untuk mendapatkan pendidikan berkualitas
        dengan dukungan finansial penuh. Proses pendaftaran mudah dan
        transparan.
      </p>
      <div class="flex justify-center gap-4">
        <a
          href="/login"
          class="bg-secondary-container text-on-secondary-container px-10 py-4 rounded-full text-sm font-semibold tracking-wider hover:scale-105 transition-transform active:scale-95 shadow-lg"
        >
          Masuk
        </a>
        <a
          href="https://wa.me/6281256968118?text=Assalamu%27alaikum%20Warahmatullahi%20Wabarakatuh.%0A%0APerkenalkan%2C%20saya%3A%0A%0ANama%20%3A%20%0ANIM%2FAngkatan%20%3A%20%0AProgram%20Studi%20%3A%20%0A%0APerihal%20%3A%20%0A%0ATerima%20kasih."
          target="_blank" rel="noopener"
          class="border border-on-primary text-on-primary px-10 py-4 rounded-full text-sm font-semibold tracking-wider hover:bg-on-primary/10 transition-colors"
        >
          Hubungi Helpdesk
        </a>
      </div>
    </div>
  </section>
</PublicLayout>
