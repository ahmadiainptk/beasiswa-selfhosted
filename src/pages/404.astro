---
// path: src/pages/404.astro
import PublicLayout from "../layouts/PublicLayout.astro";
---

<PublicLayout title="Halaman Tidak Ditemukan">
  <main class="flex-grow flex items-center justify-center relative overflow-hidden px-4 py-[80px]">
    <!-- Background Pattern -->
    <div class="absolute inset-0 bg-pattern pointer-events-none"></div>
    <div class="relative z-10 w-full max-w-4xl text-center flex flex-col items-center">
      <!-- 404 Visual -->
      <div class="relative mb-stack-lg">
        <div class="absolute inset-0 flex items-center justify-center blur-3xl opacity-20">
          <div class="w-64 h-64 bg-primary rounded-full"></div>
        </div>
        <h2 class="text-[120px] md:text-[220px] leading-none text-primary/10 select-none tracking-tighter font-extrabold font-[Montserrat]">404</h2>
        <div class="absolute inset-0 flex items-center justify-center" style="animation: float 6s ease-in-out infinite;">
          <div class="bg-surface-container-lowest p-8 rounded-xl shadow-sm border border-outline-variant/30 flex flex-col items-center max-w-[280px]">
            <div class="w-24 h-24 bg-primary-container/10 rounded-full flex items-center justify-center mb-4">
              <span class="material-symbols-outlined text-primary text-5xl" style="font-variation-settings: 'FILL' 1;">auto_stories</span>
            </div>
            <div class="h-1 w-12 bg-secondary rounded-full mb-2"></div>
            <p class="text-on-surface-variant text-sm font-semibold tracking-wider italic">"Literacy is a bridge from misery to hope."</p>
          </div>
        </div>
      </div>

      <!-- Error Message -->
      <div class="space-y-4 max-w-lg mx-auto">
        <h3 class="text-[32px] font-semibold font-[Montserrat] text-primary">Halaman Tidak Ditemukan</h3>
        <p class="text-lg leading-relaxed text-on-surface-variant">
          Maaf, halaman yang Anda cari tidak tersedia atau mungkin telah dipindahkan ke direktori lain. Silakan periksa kembali tautan yang Anda tuju.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="mt-stack-lg flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="bg-primary text-on-primary px-10 py-4 rounded-full text-sm font-semibold tracking-wider flex items-center justify-center gap-2 hover:opacity-90 shadow-sm transition-all active:scale-95 group">
          <span class="material-symbols-outlined transition-transform group-hover:-translate-x-1">arrow_back</span>
          Kembali ke Beranda
        </a>
        <button onclick="window.history.back()" class="border-2 border-secondary text-secondary px-10 py-4 rounded-full text-sm font-semibold tracking-wider flex items-center justify-center gap-2 hover:bg-secondary/5 transition-all active:scale-95">
          Halaman Sebelumnya
        </button>
      </div>

      <!-- Help Cards -->
      <div class="mt-[80px] grid grid-cols-1 md:grid-cols-3 gap-stack-md w-full">
        <div class="p-6 rounded-xl bg-surface-container hover:bg-surface-container-high transition-colors cursor-pointer border border-transparent hover:border-outline-variant/30 text-left">
          <span class="material-symbols-outlined text-primary mb-3 block text-3xl">info</span>
          <h4 class="font-semibold text-lg font-[Montserrat] text-on-surface mb-1">Bantuan Teknis</h4>
          <p class="text-on-surface-variant text-sm">Hubungi tim IT jika Anda merasa ini adalah kesalahan sistem.</p>
        </div>
        <a href="/" class="p-6 rounded-xl bg-surface-container hover:bg-surface-container-high transition-colors border border-transparent hover:border-outline-variant/30 text-left">
          <span class="material-symbols-outlined text-primary mb-3 block text-3xl">school</span>
          <h4 class="font-semibold text-lg font-[Montserrat] text-on-surface mb-1">Program Beasiswa</h4>
          <p class="text-on-surface-variant text-sm">Lihat daftar beasiswa aktif yang tersedia saat ini.</p>
        </a>
        <a href="/blog" class="p-6 rounded-xl bg-surface-container hover:bg-surface-container-high transition-colors border border-transparent hover:border-outline-variant/30 text-left">
          <span class="material-symbols-outlined text-primary mb-3 block text-3xl">search</span>
          <h4 class="font-semibold text-lg font-[Montserrat] text-on-surface mb-1">Cari Informasi</h4>
          <p class="text-on-surface-variant text-sm">Gunakan fitur pencarian untuk menemukan pengumuman terbaru.</p>
        </a>
      </div>
    </div>
  </main>
</PublicLayout>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
  }
</style>
