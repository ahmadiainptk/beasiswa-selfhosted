---
// path: src/pages/admin/profil.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
import Card from '../../components/ui/Card.astro';
import { verifyGardaToken } from "../../lib/auth";

const gardaAdmin = await verifyGardaToken(
  (Astro.locals as any).gardaCookies || Astro.request.headers.get("cookie"),
  Astro.locals.runtime?.env as any
);
if (!gardaAdmin) return Astro.redirect("/admin/login");

const admin = { namaLengkap: gardaAdmin.name, email: gardaAdmin.email, role: gardaAdmin.role };
---

<AdminLayout title="Profil" namaUser={admin.namaLengkap} userRole={admin.role} activeMenu="profil">
  <div class="mb-6">
    <h1 class="text-2xl font-extrabold text-on-surface">Profil Admin</h1>
    <p class="text-outline mt-1">Informasi akun — login via GARDA SSO</p>
  </div>

  <div class="space-y-6">
    <!-- Info Card -->
    <Card title="Informasi Akun">
      <div class="space-y-3">
        <div>
          <span class="text-sm text-outline">Email</span>
          <p class="text-on-surface font-medium">{admin.email}</p>
        </div>
        <div>
          <span class="text-sm text-outline">Role</span>
          <p class="text-on-surface font-medium">
            <span class="inline-block px-2 py-0.5 text-xs rounded-full font-medium bg-primary-container text-on-primary-container">
              {admin.role === 'superadmin' ? 'Superadmin' : admin.role === 'admin' ? 'Admin' : admin.role}
            </span>
          </p>
        </div>
        <div>
          <span class="text-sm text-outline">Login via</span>
          <p class="text-on-surface font-medium">GARDA SSO — Google OAuth</p>
        </div>
      </div>
    </Card>

    <!-- Edit Nama -->
    <Card title="Ubah Nama">
      <form id="form-nama" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-on-surface-variant mb-1.5">Nama Lengkap</label>
          <input type="text" id="input-nama" value={admin.namaLengkap} required
            class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-sm focus:ring-2 focus:ring-primary outline-none" />
        </div>
        <button type="submit" class="px-4 py-2 bg-primary hover:bg-primary text-white text-sm font-medium rounded-lg transition flex items-center gap-2">
          <span class="material-symbols-outlined text-lg">save</span>
          Simpan Nama
        </button>
        <div id="result-nama" class="hidden"></div>
      </form>
    </Card>
  </div>

  <script>
    // Update nama
    document.getElementById('form-nama').addEventListener('submit', async function(e) {
      e.preventDefault();
      var nama = document.getElementById('input-nama').value.trim();
      if (!nama) return;

      var result = document.getElementById('result-nama');
      try {
        var res = await fetch('/api/admin/profil', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'update-nama', nama_lengkap: nama }),
        });
        var data = await res.json();
        result.classList.remove('hidden');
        result.innerHTML = data.success
          ? '<p class="text-sm text-primary">' + data.message + '</p>'
          : '<p class="text-sm text-error">' + data.message + '</p>';
      } catch (err) {
        result.classList.remove('hidden');
        result.innerHTML = '<p class="text-sm text-error">Terjadi kesalahan</p>';
      }
    });
  </script>
</AdminLayout>
