{
  "name": "beasiswa-selfhosted",
  "type": "module",
  "version": "0.1.0",
  "description": "Beasiswa IAIN Pontianak — self-hosted (Node.js + SQLite). Fork dari beasiswa-iain yang berjalan di Cloudflare Workers + D1.",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@libsql/client": "^0.17.4",
    "@tailwindcss/vite": "^4.3.2",
    "alpinejs": "^3.15.12",
    "astro": "^7.3.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
