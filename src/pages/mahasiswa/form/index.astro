  <!-- Status Message -->
  <div id="save-status" class="hidden fixed bottom-4 right-4 z-50"></div>

  <script define:vars={{ step }} is:inline>
    const form = document.getElementById("form-wizard");
    const statusEl = document.getElementById("save-status");
    const STEP_VALUE = { step };
    // SPA state — mulai dari step yang di-render server (default 1)
    let currentStep = STEP_VALUE.step || 1;
    const MAX_STEP = 7;

    function showStatus(msg, type) {
      statusEl.innerHTML = `
        <div class="flex items-center gap-2 px-4 py-3 rounded-lg shadow-lg text-sm font-medium ${
          type === "success" ? "bg-primary text-white" : "bg-error text-white"
        }">
          <span class="material-symbols-outlined text-lg">${type === "success" ? "check_circle" : "error"}</span>
          ${msg}
        </div>
      `;
      statusEl.classList.remove("hidden");
      setTimeout(() => statusEl.classList.add("hidden"), 3000);
    }

    function showStep(n) {
      if (n < 1 || n > MAX_STEP) return;
      currentStep = n;
      document.querySelectorAll("[data-step-panel]").forEach((panel) => {
        const stepNum = parseInt(panel.getAttribute("data-step"));
        panel.classList.toggle("hidden", stepNum !== n);
      });
      // Update stepper active state (swap Tailwind classes)
      document.querySelectorAll("[data-step-link]").forEach((link) => {
        const stepNum = parseInt(link.getAttribute("data-step-link"));
        const dot = link.querySelector(".stepper-dot");
        const isActive = stepNum === n;
        const isCompleted = link.classList.contains("completed");
        // Link text color
        link.classList.toggle("text-primary", isActive || isCompleted);
        link.classList.toggle(
          "text-outline-variant",
          !isActive && !isCompleted,
        );
        // Dot visual
        if (dot) {
          dot.classList.toggle("border-blue-600", isActive);
          dot.classList.toggle("border-green-600", !isActive && isCompleted);
          dot.classList.toggle("bg-primary", isActive || isCompleted);
          dot.classList.toggle("text-white", isActive || isCompleted);
          dot.classList.toggle(
            "text-outline-variant",
            !isActive && !isCompleted,
          );
          dot.textContent = isCompleted && !isActive ? "✓" : "" + stepNum;
        }
      });
      // Update "Simpan & Lanjut" vs "Review"
      const btnNext = document.getElementById("btn-next");
      const btnReview = document.getElementById("btn-review");
      if (btnNext) btnNext.classList.toggle("hidden", n >= MAX_STEP);
      if (btnReview) btnReview.classList.toggle("hidden", n < MAX_STEP);
      // Update card title (the h3 inside the Card wrapping #form-wizard)
      const formCard = form.closest(".rounded-xl");
      const titleEl = formCard ? formCard.querySelector("h3") : null;
      if (titleEl) {
        const labels = {
          1: "Identitas Pribadi",
          2: "Riwayat Pendidikan",
          3: "Prestasi & Tahfidz",
          4: "Identitas Keluarga",
          5: "Kondisi Rumah",
          6: "Domisili Ortu/Wali",
          7: "Kebutuhan Khusus",
        };
        titleEl.textContent = `Bagian ${n}: ${labels[n] || ""}`;
      }
      // Update URL hash without reload (history) — supaya back/refresh tetap di step ini
      if (history && history.replaceState) {
        const url = new URL(window.location.href);
        url.searchParams.set("step", String(n));
        history.replaceState(null, "", url.pathname + url.search);
      }
      // Peta OpenStreetMap di step 6 perlu di-resize saat panel jadi terlihat
      if (n === 6 && gmMaps.length) {
        setTimeout(function () { gmMaps.forEach(function (m) { m.invalidateSize(); }); }, 80);
      }
    }

    // Format input uang: buang non-angka, tampilkan pemisah ribuan (titik).
    // Saat save, getFormData strip titik → simpan integer bersih (1000000).
    function formatMoney(value) {
      const digits = (value || "").replace(/\D/g, "");
      return digits === "" ? "" : Number(digits).toLocaleString("id-ID");
    }
    function attachMoneyMasks() {
      document.querySelectorAll("input[data-money]").forEach((el) => {
        if (el.dataset.masked === "1") return;
        el.dataset.masked = "1";
        el.addEventListener("input", () => {
          const caretBefore = el.selectionStart;
          const dotBefore = (el.value.slice(0, caretBefore).match(/\./g) || []).length;
          el.value = formatMoney(el.value);
          // restore caret roughly
          const digitsBefore = (el.value.replace(/\D/g, "").length);
          const desired = dotBefore + digitsBefore;
          try { el.setSelectionRange(desired, desired); } catch (e) {}
        });
      });
    }
    attachMoneyMasks();
    // Re-attach when switching steps (each step panel re-rendered? no — all steps in DOM; but a
    // guard ensures we only attach once per element). Run once more is safe & idempotent.

    // --- Google Maps / lokasi picker (Leaflet + OpenStreetMap — gratis, tanpa API key) ---
    var gmMaps = [];
    function loadLeaflet(cb) {
      if (window.L) { cb(window.L); return; }
      if (!document.querySelector('link[href*="leaflet.css"]')) {
        var css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
        document.head.appendChild(css);
      }
      var s = document.createElement('script');
      s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      s.onload = function () { cb(window.L); };
      s.onerror = function () { console.warn("Leaflet gagal dimuat"); };
      document.head.appendChild(s);
    }
    function parseGmapCoords(v) {
      if (!v) return null;
      v = String(v).trim();
      var m = v.match(/^(-?\d+(?:\.\d+)?),\s*(-?\d+(?:\.\d+)?)$/);
      if (m) return { lat: parseFloat(m[1]), lng: parseFloat(m[2]) };
      m = v.match(/@(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)/);
      if (m) return { lat: parseFloat(m[1]), lng: parseFloat(m[2]) };
      m = v.match(/[?&](?:q|center|ll)=(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)/);
      if (m) return { lat: parseFloat(m[1]), lng: parseFloat(m[2]) };
      m = v.match(/\/(?:maps|place)\/(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)/);
      if (m) return { lat: parseFloat(m[1]), lng: parseFloat(m[2]) };
      return null;
    }
    function initGmaps() {
      loadLeaflet(function (L) {
        document.querySelectorAll(".gmap-picker").forEach(function (wrap, idx) {
          var mapDiv = wrap.querySelector(".gmap-map");
          var input = wrap.querySelector('input[name^="gmap_"]');
          if (!mapDiv || !input) return;
          var key = "gm-" + idx + "-" + Math.random().toString(36).slice(2, 6);
          mapDiv.id = key;
          var map = L.map(key, { scrollWheelZoom: false }).setView([-0.026, 109.343], 13);
          L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 19, attribution: "&copy; OpenStreetMap" }).addTo(map);
          var marker = null;
          function setLoc(lat, lng, zoom) {
            if (typeof lat !== "number" || typeof lng !== "number" || isNaN(lat) || isNaN(lng)) return;
            var z = zoom || 16;
            if (marker) marker.setLatLng([lat, lng]);
            else {
              marker = L.marker([lat, lng], { draggable: true }).addTo(map);
              marker.on("dragend", function () { setLoc(marker.getLatLng().lat, marker.getLatLng().lng, z); });
            }
            map.setView([lat, lng], z);
            input.value = "https://www.google.com/maps?q=" + lat.toFixed(6) + "," + lng.toFixed(6);
          }
          map.on("click", function (e) { setLoc(e.latlng.lat, e.latlng.lng); });
          wrap.querySelector(".gmap-geo").addEventListener("click", function () {
            if (!navigator.geolocation) { alert("Browser tidak mendukung geolokasi."); return; }
            navigator.geolocation.getCurrentPosition(
              function (pos) { setLoc(pos.coords.latitude, pos.coords.longitude); },
              function () { alert("Gagal mengambil lokasi. Izinkan akses lokasi di browser."); },
              { enableHighAccuracy: true, timeout: 10000 }
            );
          });
          input.addEventListener("change", function () {
            var c = parseGmapCoords(input.value);
            if (c) setLoc(c.lat, c.lng);
          });
          var c0 = parseGmapCoords(input.value);
          if (c0) setLoc(c0.lat, c0.lng, 15);
          gmMaps.push(map);
        });
      });
    }
    initGmaps();

    function getFormData() {
      // Collect HANYA fields dari step aktive (data-step-panel yang terlihat)
      const active = document.querySelector(
        `[data-step-panel][data-step="${currentStep}"]`,
      );
      const data = {};
      if (active) {
        const fields = active.querySelectorAll("input, select, textarea");
        const MONEY_KEYS = new Set([
          "nominalUkt", "penghasilanAyah", "penghasilanIbu", "penghasilanWali",
          "biayaSewa", "biayaListrik1", "biayaListrik2", "biayaListrik3",
          "jumlahHutang", "cicilanHutang", "jumlahPiutang", "cicilanPiutang",
        ]);
        fields.forEach((el) => {
          if (!el.name) return;
          const camelKey = el.name.replace(/_([a-z])/g, (_, c) =>
            c.toUpperCase(),
          );
          if (MONEY_KEYS.has(camelKey)) {
            // Strip titik/koma/spasi & non-digit → integer bersih (simpan 1000000, bukan "1.000.000")
            const digits = (el.value || "").replace(/\D/g, "");
            data[camelKey] = digits === "" ? null : Number(digits);
            return;
          }
          data[camelKey] =
            el.type === "checkbox" ? (el.checked ? 1 : 0) : el.value || null;
        });

        // Prestasi (step 3): kumpulkan SEMUA item, bukan cuma satu (fix bug 3→1)
        if (currentStep === 3) {
          const items = [];
          active.querySelectorAll("#prestasi-list .prestasi-item").forEach((item) => {
            const get = (n) => (item.querySelector(`[name="${n}"]`)?.value || "").toString().trim();
            items.push({
              namaLomba: get("nama_lomba"),
              jenisLomba: get("jenis_lomba"),
              tingkatLomba: get("tingkat_lomba"),
              predikatJuara: get("predikat_juara"),
            });
          });
          const kept = items.filter((it) => it.namaLomba || it.jenisLomba || it.tingkatLomba || it.predikatJuara);
          data.prestasiList = kept.length ? JSON.stringify(kept) : "";
          // Hapus field prestasi flat (tidak dipakai lagi, hindari tumpang tindih dengan prestasiList)
          delete data.namaLomba;
          delete data.jenisLomba;
          delete data.tingkatLomba;
          delete data.predikatJuara;
        }
      }
      return data;
    }

    // Conditional document requirements — handled via static hint text above.
    // KIP diisi → upload KIP wajib. KKS/PKH/SKTM/SK Penghasilan: minimal satu wajib.
    // Admin akan memverifikasi kelengkapan. User cukup diinformasikan.

    // Tombol tambah prestasi (step 3)
    var btnTambah = document.getElementById("btn-tambah-prestasi");
    if (btnTambah) {
      function renumberPrestasi() {
        var items = document.querySelectorAll("#prestasi-list .prestasi-item");
        items.forEach(function (item, i) {
          var header = item.querySelector(".prestasi-header");
          if (header) {
            var delBtn = header.querySelector("button");
            header.textContent = "Prestasi Ke-" + (i + 1);
            if (delBtn) header.appendChild(delBtn);
          }
        });
      }

      btnTambah.addEventListener("click", function () {
        var list = document.getElementById("prestasi-list");
        var template = list.querySelector(".prestasi-item");
        var clone = template.cloneNode(true);
        var inputs = clone.querySelectorAll("input, select");
        inputs.forEach(function (el) {
          el.value = "";
        });
        var header = clone.querySelector(".prestasi-header");
        var delBtn = document.createElement("button");
        delBtn.type = "button";
        delBtn.className =
          "text-error hover:bg-error-container p-1 rounded ml-auto";
        delBtn.innerHTML =
          '<span class=\\"material-symbols-outlined text-sm\\">delete</span>';
        delBtn.onclick = function () {
          clone.remove();
          renumberPrestasi();
        };
        if (header) {
          header.style.display = "flex";
          header.style.alignItems = "center";
          header.appendChild(delBtn);
        }
        list.appendChild(clone);
        renumberPrestasi();
      });

      var firstHeader = document.querySelector(
        "#prestasi-list .prestasi-header",
      );
      if (firstHeader && !firstHeader.querySelector("button")) {
        firstHeader.style.display = "flex";
        firstHeader.style.alignItems = "center";
        var firstDel = document.createElement("button");
        firstDel.type = "button";
        firstDel.className =
          "text-outline-variant hover:bg-error-container p-1 rounded ml-auto";
        firstDel.innerHTML =
          '<span class=\\\"material-symbols-outlined text-sm\\\">delete</span>';
        firstDel.onclick = function () {
          var item = firstHeader.closest(".prestasi-item");
          if (
            document.querySelectorAll("#prestasi-list .prestasi-item").length >
            1
          ) {
            item.remove();
            renumberPrestasi();
          }
        };
        firstHeader.appendChild(firstDel);
      }
    }

    async function saveForm(targetStep) {
      // targetStep optional; default currentStep. Simpan step UNTUK setiap step yg punya data terisi.
      // Kalau currentStep berubah, data di form masih utuh (semua step dirender).
      const stepToSave = targetStep || currentStep;
      const data = getFormData();
      const res = await fetch("/api/pendaftaran/save", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ step: stepToSave, data }),
      });
      return res.json();
    }

    // Save button
    document.getElementById("btn-save").addEventListener("click", async () => {
      const result = await saveForm();
      if (result.success) {
        showStatus("Data berhasil disimpan", "success");
      } else {
        showStatus(result.error || "Gagal menyimpan", "error");
      }
    });

    // Next button
    const btnNext = document.getElementById("btn-next");
    if (btnNext) {
      btnNext.addEventListener("click", async () => {
        const result = await saveForm();
        if (result.success) {
          showStep(currentStep + 1);
        } else {
          showStatus(result.error || "Gagal menyimpan", "error");
        }
      });
    }

    // Back button
    const btnBack = document.getElementById("btn-back");
    if (btnBack) {
      btnBack.addEventListener("click", () => showStep(currentStep - 1));
    }

    // Stepper links (client-side nav)
    document.querySelectorAll("[data-step-link]").forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const n = parseInt(link.getAttribute("data-step-link"));
        showStep(n);
      });
    });

    // Review button (step 7)
    const btnReview = document.getElementById("btn-review");
    if (btnReview) {
      btnReview.addEventListener("click", async () => {
        const result = await saveForm();
        if (result.success) {
          window.location.href = "/mahasiswa/form/review";
        } else {
          showStatus(result.error || "Gagal menyimpan", "error");
        }
      });
    }

    // Init: show the server-rendered step
    showStep(currentStep);
  </script>
</MahasiswaLayout>
