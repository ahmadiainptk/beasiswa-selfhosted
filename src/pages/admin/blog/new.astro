---
// path: src/pages/admin/blog/new.astro
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Card from '../../../components/ui/Card.astro';
import { drizzle } from 'drizzle-orm/d1';
import * as schema from '../../../db/schema';
import { blogCategories } from '../../../db/schema';
import { verifyGardaToken } from "../../../lib/auth";

const gardaAdmin = await verifyGardaToken(
  (Astro.locals as any).gardaCookies || Astro.request.headers.get("cookie"),
  Astro.locals.runtime?.env as any
);
if (!gardaAdmin) return Astro.redirect("/admin/login");

const admin = { namaLengkap: gardaAdmin.name, email: gardaAdmin.email, role: gardaAdmin.role };
const db = drizzle(Astro.locals.runtime.env?.DB, { schema });
let categories: any[] = [];
try { categories = await db.select().from(blogCategories).orderBy(blogCategories.name); } catch (e) {}
---

<AdminLayout title="Tambah Post" namaUser={admin.namaLengkap} userRole={admin.role} activeMenu="blog">
  <div class="mb-6">
    <a href="/admin/blog" class="inline-flex items-center gap-1 text-sm text-outline hover:text-on-surface-variant mb-4">
      <span class="material-symbols-outlined text-lg">arrow_back</span> Kembali
    </a>
    <h1 class="text-2xl font-extrabold text-on-surface">Buat Post Baru</h1>
    <p class="text-outline mt-1">Isi metadata lalu buat Google Doc untuk konten</p>
  </div>

  <Card>
    <form id="blog-form" class="space-y-5">
      <div>
        <label class="block text-sm font-medium text-on-surface-variant mb-1">Judul <span class="text-error">*</span></label>
        <input type="text" name="title" required placeholder="Judul post"
          class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none" />
      </div>

      <div>
        <label class="block text-sm font-medium text-on-surface-variant mb-1">Kategori</label>
        <select name="category_id"
          class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none">
          <option value="">Tanpa Kategori</option>
          {categories.map((cat) => (<option value={cat.id}>{cat.name}</option>))}
        </select>
      </div>

      <div>
        <label class="block text-sm font-medium text-on-surface-variant mb-1">Tag</label>
        <input type="text" name="tags" placeholder="Gunakan koma untuk memisahkan tag"
          class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none" />
        <p class="text-xs text-outline-variant mt-1">Contoh: beasiswa, prestasi, akademik</p>
      </div>

      <div>
        <label class="block text-sm font-medium text-on-surface-variant mb-1">Ringkasan (Excerpt)</label>
        <textarea name="excerpt" rows="2" placeholder="Ringkasan singkat post..."
          class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"></textarea>
      </div>

      <div>
        <label class="block text-sm font-medium text-on-surface-variant mb-1">Gambar Sampul</label>
        <div class="flex items-center gap-3">
          <input type="file" id="cover-file" accept="image/*" class="hidden" />
          <button type="button" id="cover-upload-btn" class="px-3 py-2 text-sm border border-outline-variant rounded-lg hover:bg-surface-container-high transition flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">upload</span> Upload
          </button>
          <input type="hidden" name="cover_image" id="cover-url" />
          <span id="cover-preview" class="text-xs text-outline"></span>
          <span id="cover-spinner" style="display:none" class="material-symbols-outlined text-sm animate-spin text-primary">progress_activity</span>
        </div>
        <p class="text-xs text-outline-variant mt-1">Atau isi URL manual di bawah</p>
      </div>

      <div>
        <label class="block text-sm font-medium text-on-surface-variant mb-1">URL Gambar (Manual)</label>
        <input type="url" name="cover_image_manual" id="cover-url-manual" placeholder="https://example.com/image.jpg"
          class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none" />
      </div>

      <div id="form-message" class="text-sm"></div>

      <button type="submit" id="submit-btn" class="inline-flex items-center gap-2 bg-primary hover:bg-primary text-white font-medium px-5 py-2.5 rounded-lg text-sm transition-colors">
        <span class="material-symbols-outlined text-lg">add</span>
        Buat Google Doc
      </button>
      <p class="text-xs text-outline-variant">Akan membuka Google Docs di tab baru untuk menulis artikel.</p>
    </form>
  </Card>

  <script>
    var form = document.getElementById('blog-form');
    var btn = document.getElementById('submit-btn');
    var msg = document.getElementById('form-message');
    var coverFile = document.getElementById('cover-file');
    var coverBtn = document.getElementById('cover-upload-btn');
    var coverUrl = document.getElementById('cover-url');
    var coverUrlManual = document.getElementById('cover-url-manual');
    var coverPreview = document.getElementById('cover-preview');
    var coverSpinner = document.getElementById('cover-spinner');

    coverBtn.addEventListener('click', function() { coverFile.click(); });
    coverFile.addEventListener('change', async function() {
      var file = coverFile.files[0];
      if (!file) return;
      coverBtn.disabled = true;
      coverSpinner.style.display = 'inline-block';
      coverPreview.textContent = 'Mengkompresi...';

      try {
        // Compress image client-side before upload
        var compressed = file;
        if (file.type.startsWith('image/')) {
          var bitmap = await createImageBitmap(file);
          var w = Math.min(bitmap.width, 1200);
          var h = Math.round((w / bitmap.width) * bitmap.height);
          var canvas = document.createElement('canvas');
          canvas.width = w; canvas.height = h;
          var ctx = canvas.getContext('2d');
          ctx.drawImage(bitmap, 0, 0, w, h);
          bitmap.close();
          var blob = await new Promise(function(r) { canvas.toBlob(r, 'image/jpeg', 0.8); });
          compressed = new File([blob], 'blog_' + Date.now() + '.jpg', { type: 'image/jpeg' });
        }

        coverPreview.textContent = 'Mengupload...';
        var fd2 = new FormData();
        fd2.append('file', compressed, compressed.name);
        var upRes = await fetch('/api/admin/upload-cover', { method: 'POST', body: fd2 });
        var upData = await upRes.json();
        if (upData.success) {
          coverUrl.value = upData.url;
          coverUrlManual.value = upData.url;
          coverPreview.textContent = 'OK ' + file.name;
          coverPreview.className = 'text-xs text-primary';
        } else {
          coverPreview.textContent = 'Gagal: ' + (upData.message || 'Error');
          coverPreview.className = 'text-xs text-error';
        }
      } catch(err) {
        coverPreview.textContent = 'Error';
        coverPreview.className = 'text-xs text-error';
      }
      coverSpinner.style.display = 'none';
      coverBtn.disabled = false;
    });

    coverUrlManual.addEventListener('input', function() {
      coverUrl.value = coverUrlManual.value;
    });

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      btn.disabled = true;
      btn.innerHTML = '<span class="material-symbols-outlined text-lg animate-spin">progress_activity</span> Membuat Google Doc...';
      msg.innerHTML = '';
      var fd = new FormData(form);
      try {
        var res = await fetch('/api/admin/blog', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'create-doc',
            title: fd.get('title'),
            category_id: fd.get('category_id') || undefined,
            tags: fd.get('tags') || undefined,
            excerpt: fd.get('excerpt') || undefined,
            cover_image: fd.get('cover_image') || undefined,
          }),
        });
        var data = await res.json();
        if (data.success) {
          msg.innerHTML = '<span class="text-primary">Doc dibuat! Membuka Google Docs...</span>';
          window.open(data.docUrl, '_blank');
          setTimeout(function() { window.location.href = '/admin/blog'; }, 1000);
        } else {
          msg.innerHTML = '<span class="text-error">' + (data.message || 'Gagal') + '</span>';
          btn.disabled = false;
          btn.innerHTML = '<span class="material-symbols-outlined text-lg">add</span> Buat Google Doc';
        }
      } catch(err) {
        msg.innerHTML = '<span class="text-error">Terjadi kesalahan: ' + err.message + '</span>';
        btn.disabled = false;
        btn.innerHTML = '<span class="material-symbols-outlined text-lg">add</span> Buat Google Doc';
      }
    });
  </script>
</AdminLayout>
