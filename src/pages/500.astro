---
// path: src/pages/500.astro
import PublicLayout from "../layouts/PublicLayout.astro";
---

<PublicLayout title="Server Error">
  <main class="flex-grow flex items-center justify-center relative px-4 py-[80px] overflow-hidden">
    <!-- Decorative Elements -->
    <div class="absolute w-[400px] h-[400px] -top-20 -left-20 pointer-events-none" style="background: radial-gradient(circle, rgba(0,77,39,0.1) 0%, rgba(255,255,255,0) 70%); filter: blur(40px);"></div>
    <div class="absolute w-[400px] h-[400px] -bottom-20 -right-20 pointer-events-none" style="background: radial-gradient(circle, rgba(0,77,39,0.1) 0%, rgba(255,255,255,0) 70%); filter: blur(40px);"></div>

    <div class="max-w-4xl w-full flex flex-col md:flex-row items-center gap-stack-lg relative z-10">
      <!-- Visual Section -->
      <div class="w-full md:w-1/2 flex justify-center items-center">
        <div class="relative w-64 h-64 md:w-80 md:h-80">
          <div class="absolute inset-0 border border-primary/10 rounded-full" style="animation: spin 20s linear infinite;"></div>
          <div class="absolute inset-4 border border-secondary/20 rounded-full" style="animation: spin 15s linear infinite reverse;"></div>
          <div class="absolute inset-0 flex items-center justify-center" style="animation: float 6s ease-in-out infinite;">
            <div class="bg-white p-8 rounded-full shadow-lg border border-outline-variant/30">
              <span class="material-symbols-outlined text-primary text-[80px] md:text-[120px]">construction</span>
              <div class="absolute -top-2 -right-2 bg-error text-white p-3 rounded-full shadow-md">
                <span class="material-symbols-outlined text-[24px]">priority_high</span>
              </div>
            </div>
          </div>
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3 h-3 bg-secondary rounded-full blur-[1px] opacity-40"></div>
          <div class="absolute bottom-10 right-0 w-2 h-2 bg-primary rounded-full blur-[1px] opacity-40"></div>
        </div>
      </div>

      <!-- Text Content -->
      <div class="w-full md:w-1/2 text-center md:text-left">
        <div class="inline-block px-4 py-1.5 bg-error-container text-on-error-container text-sm font-semibold tracking-wider rounded-full mb-6">
          Error 500: Server Terkendala
        </div>
        <h1 class="text-[32px] md:text-[48px] font-bold font-[Montserrat] text-primary mb-4 leading-tight">
          Ups! Sesuatu <br class="hidden md:block" />Tidak Beres.
        </h1>
        <p class="text-lg leading-relaxed text-on-surface-variant mb-stack-lg max-w-md mx-auto md:mx-0">
          Terjadi kesalahan internal pada server kami. Tim kami sedang berusaha memperbaikinya agar Anda dapat segera kembali melanjutkan pendaftaran beasiswa.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
          <button onclick="window.location.reload()" class="flex items-center justify-center gap-2 bg-primary text-on-primary px-8 py-4 rounded-full text-sm font-semibold tracking-wider shadow-md hover:shadow-xl hover:scale-105 active:scale-95 transition-all duration-300">
            <span class="material-symbols-outlined">refresh</span>
            Muat Ulang Halaman
          </button>
          <a href="https://wa.me/6281256968118?text=Assalamu%27alaikum%20Warahmatullahi%20Wabarakatuh.%0A%0APerkenalkan%2C%20saya%3A%0A%0ANama%20%3A%20%0ANIM%2FAngkatan%20%3A%20%0AProgram%20Studi%20%3A%20%0A%0APerihal%20%3A%20%0A%0ATerima%20kasih." target="_blank" rel="noopener" class="flex items-center justify-center gap-2 bg-white text-secondary border-2 border-secondary px-8 py-4 rounded-full text-sm font-semibold tracking-wider hover:bg-secondary hover:text-white transition-all duration-300">
            <span class="material-symbols-outlined">contact_support</span>
            Helpdesk
          </a>
        </div>
        <div class="mt-12 flex items-center justify-center md:justify-start gap-4 text-on-surface-variant/60">
          <span class="text-sm font-semibold tracking-wider">Status Sistem:</span>
          <div class="flex items-center gap-2 bg-surface-container-high px-3 py-1 rounded-md">
            <span class="w-2 h-2 bg-error rounded-full animate-pulse"></span>
            <span class="text-[12px] font-bold uppercase tracking-wider">Maintenance</span>
          </div>
        </div>
      </div>
    </div>
  </main>
</PublicLayout>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
  }
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>
