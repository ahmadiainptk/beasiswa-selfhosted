# ===== Beasiswa Self-Hosted — contoh variabel lingkungan =====
# Salin ke .env lalu isi nilai REAL (jangan commit .env). Semua nilai di
# file ini adalah placeholder. Jangan pernah menaruh secret asli di repo.

# --- Database (SQLite file) ---
# Default: file:./data/beasiswa.db (relatif ke working dir proses)
BEASISWA_DB_URL=file:./data/beasiswa.db

# --- Admin auth (GARDA SSO JWT) ---
# GARDA_SECRET dipakai verifikasi token admin. WAJIB diisi — tanpa ini admin
# zone tidak bisa diakses (verifyGardaToken mengembalikan null).
# Gunakan secret yang kuat & berbeda dari deployment lain.
GARDA_SECRET=ganti_dengan_secret_kuat

# --- Maintenance mode ---
# "true" = custom domain redirect ke /maintenance (mirip Cloudflare)
STATUS_MAINTENANCE=false

# --- Google Drive (upload file: foto, dokumen, SK, cover blog) ---
# Opsional — kalau tidak diisi, fitur upload/Drive tidak akan jalan.
# Pilih salah satu: (A) GOOGLE_PRIVATE_KEY + GOOGLE_CLIENT_EMAIL, atau
#                 (B) GOOGLE_SERVICE_ACCOUNT_JSON (seluruh JSON service account).
GDRIVE_FOLDER_ID=
GDRIVE_BLOG_FOLDER_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
