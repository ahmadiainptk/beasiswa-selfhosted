---
// path: src/pages/admin/login.astro
import PublicLayout from "../../layouts/PublicLayout.astro";

// Already logged in via GARDA? Redirect to admin dashboard
const admin = (Astro.locals as any).admin;
if (admin) {
  return Astro.redirect("/admin");
}

const callbackUrl = new URL("/admin", Astro.url).toString();
const gardaLoginUrl = `https://auth.iainptk.ac.id/login?app=beasiswa&callback=${encodeURIComponent(callbackUrl)}`;
---

<PublicLayout title="Login Admin">
  <div class="min-h-[80vh] flex flex-col items-center justify-center px-4">
    <div class="bg-surface-container-lowest p-8 rounded-2xl shadow-xl max-w-md w-full text-center border border-outline-variant">
      <div class="mb-6 flex justify-center">
        <div class="p-4 bg-primary-container rounded-full">
          <span class="material-symbols-outlined text-4xl text-on-primary-container">shield_person</span>
        </div>
      </div>

      <h1 class="text-2xl font-extrabold text-on-surface mb-2">
        Administrator Login
      </h1>
      <p class="text-outline mb-8 leading-relaxed">
        Silakan masuk menggunakan akun Google IAIN Pontianak Anda
        melalui sistem GARDA.
      </p>

      <a
        href={gardaLoginUrl}
        class="block w-full py-3.5 px-4 bg-primary hover:bg-primary-dark text-on-primary font-bold rounded-xl shadow-lg shadow-primary/20 transition-all flex items-center justify-center gap-3"
      >
        <span class="material-symbols-outlined">verified_user</span>
        Masuk via GARDA
      </a>

      <div class="mt-6 pt-6 border-t border-outline-variant">
        <p class="text-xs text-outline-variant">
          Hanya akun @iainptk.ac.id yang dapat mengakses panel admin.
        </p>
        <p class="text-xs text-outline-variant mt-1">
          Masalah akses? Hubungi tim PTID.
        </p>
      </div>
    </div>
  </div>
</PublicLayout>
