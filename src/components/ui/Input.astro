---
// path: src/components/ui/Input.astro
interface Props {
  label: string;
  name: string;
  type?: string;
  placeholder?: string;
  required?: boolean;
  value?: string;
  error?: string;
  class?: string;
}

const {
  label,
  name,
  type = 'text',
  placeholder = '',
  required = false,
  value = '',
  error = '',
  class: className = '',
} = Astro.props;
---

<div class:list={[className]}>
  <label for={name} class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
    {label}
    {required && <span class="text-red-500">*</span>}
  </label>
  <input
    type={type}
    id={name}
    name={name}
    value={value}
    placeholder={placeholder}
    required={required}
    class:list={[
      'w-full px-3 py-2.5 rounded-lg border bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-blue-600 focus:border-blue-600 outline-none transition',
      error
        ? 'border-red-300 dark:border-red-700'
        : 'border-slate-300 dark:border-slate-700',
    ]}
  />
  {error && (
    <p class="mt-1 text-sm text-red-600 dark:text-red-400">{error}</p>
  )}
</div>
