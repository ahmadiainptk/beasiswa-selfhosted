---
// path: src/layouts/PublicLayout.astro
// Shared layout: landing, blog, login, register, changelog, maintenance
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  url?: string;
}

const { title, description, image, url } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} url={url}>
  <!-- Navbar -->
  <nav class="sticky top-0 left-0 right-0 z-50 bg-surface/95 backdrop-blur-md border-b border-outline-variant">
    <div class="flex justify-between items-center px-gutter w-full max-w-[1280px] mx-auto h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-stack-sm shrink-0">
        <span class="material-symbols-outlined text-primary text-[32px]">account_balance</span>
        <span class="font-semibold text-lg text-primary font-[Montserrat] hidden sm:inline">Beasiswa IAIN Pontianak</span>
      </a>

      <!-- Nav Links -->
      <div class="flex items-center gap-6">
        <a href="/" class="text-on-surface-variant text-sm font-semibold tracking-wider uppercase hover:text-primary transition-colors duration-200">Home</a>
        <a href="/blog" class="text-on-surface-variant text-sm font-semibold tracking-wider uppercase hover:text-primary transition-colors duration-200">Berita</a>
        <a href="/login" class="bg-primary text-on-primary px-6 py-2 rounded-full text-sm font-semibold tracking-wider hover:opacity-90 active:scale-95 transition-all">Masuk</a>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-primary text-on-primary border-t border-on-primary/10">
    <div class="max-w-[1280px] mx-auto px-gutter pt-[80px] pb-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-stack-lg mb-[80px]">
        <!-- Brand Info -->
        <div class="space-y-stack-md">
          <div class="flex items-center gap-stack-sm">
            <span class="material-symbols-outlined text-[32px] text-secondary-fixed">account_balance</span>
            <span class="font-semibold text-2xl font-[Montserrat] text-on-primary">IAIN Pontianak</span>
          </div>
          <p class="text-sm leading-relaxed text-on-primary/70">
            Institut Agama Islam Negeri Pontianak adalah perguruan tinggi keagamaan Islam negeri unggulan di Kalimantan Barat.
          </p>
          <div class="flex gap-4">
            <a href="#" class="w-10 h-10 rounded-full border border-on-primary/20 flex items-center justify-center hover:bg-secondary hover:text-on-secondary transition-all">
              <span class="material-symbols-outlined">public</span>
            </a>
            <a href="#" class="w-10 h-10 rounded-full border border-on-primary/20 flex items-center justify-center hover:bg-secondary hover:text-on-secondary transition-all">
              <span class="material-symbols-outlined">alternate_email</span>
            </a>
          </div>
        </div>

        <!-- Navigasi Situs -->
        <div>
          <h4 class="font-semibold text-lg font-[Montserrat] text-on-primary mb-6">Navigasi Situs</h4>
          <ul class="space-y-4">
            <li><a href="#" class="text-on-primary/80 hover:text-secondary-fixed transition-colors text-sm">Tentang Beasiswa</a></li>
            <li><a href="#" class="text-on-primary/80 hover:text-secondary-fixed transition-colors text-sm">Prosedur Pendaftaran</a></li>
            <li><a href="#" class="text-on-primary/80 hover:text-secondary-fixed transition-colors text-sm">Unduh Berkas</a></li>
            <li><a href="#" class="text-on-primary/80 hover:text-secondary-fixed transition-colors text-sm">Peta Situs</a></li>
          </ul>
        </div>

        <!-- Kontak -->
        <div>
          <h4 class="font-semibold text-lg font-[Montserrat] text-on-primary mb-6">Kontak Kami</h4>
          <ul class="space-y-4 text-on-primary/80 text-sm">
            <li class="flex gap-3">
              <span class="material-symbols-outlined text-secondary-fixed">location_on</span>
              <span>Jl. Letnan Jenderal Suprapto No.19, Pontianak, Kalimantan Barat</span>
            </li>
            <li class="flex gap-3">
              <span class="material-symbols-outlined text-secondary-fixed">call</span>
              <span>(0561) 740601</span>
            </li>
            <li class="flex gap-3">
              <span class="material-symbols-outlined text-secondary-fixed">mail</span>
              <span>humas@iainptk.ac.id</span>
            </li>
          </ul>
        </div>

        <!-- Map -->
        <div class="rounded-xl overflow-hidden h-48 relative border border-on-primary/20">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3989.755!2d109.3379706!3d-0.038649!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e1d59b26f7410ab%3A0xc83db77284903597!2sIAIN%20Pontianak!5e0!3m2!1sen!2sid!4v1"
            width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="absolute inset-0 w-full h-full"></iframe>
        </div>
      </div>

      <div class="flex flex-col md:flex-row justify-between items-center py-stack-md border-t border-on-primary/10 gap-stack-md">
        <p class="text-sm text-on-primary/60">&copy; {new Date().getFullYear()} IAIN Pontianak. All Rights Reserved.</p>
        <div class="flex gap-8 text-sm">
          <a href="#" class="text-on-primary/60 hover:text-on-primary transition-colors">Kebijakan Privasi</a>
          <a href="#" class="text-on-primary/60 hover:text-on-primary transition-colors">Syarat &amp; Ketentuan</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Mobile bottom spacing -->
  <div class="h-4 lg:hidden"></div>
</BaseLayout>
