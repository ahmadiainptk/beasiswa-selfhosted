---
// path: src/pages/mahasiswa/form/[step].astro
import MahasiswaLayout from "../../../layouts/MahasiswaLayout.astro";
import Card from "../../../components/ui/Card.astro";
import FileUploadBox from "../../../components/ui/FileUploadBox.astro";

import { drizzle } from "drizzle-orm/d1";
import { eq } from "drizzle-orm";
import * as schema from "../../../db/schema";
import {
  sessions,
  users,
  identitasPribadi,
  riwayatPendidikan,
  prestasiTahfidz,
  identitasKeluarga,
  kondisiRumah,
  domisiliOrtu,
  kebutuhanKhusus,
  dokumen,
} from "../../../db/schema";
import { getCookieName } from "../../../lib/auth";

// Auth check
const token = Astro.cookies.get(getCookieName())?.value;
if (!token || !Astro.locals.runtime.env?.DB) {
  return Astro.redirect("/login");
}

const db = drizzle(Astro.locals.runtime.env?.DB, { schema });

const session = await db
  .select()
  .from(sessions)
  .innerJoin(users, eq(sessions.userId, users.id))
  .where(eq(sessions.token, token))
  .limit(1);

if (
  session.length === 0 ||
  new Date(session[0].sessions.expiresAt) < new Date()
) {
  return Astro.redirect("/login");
}

const user = session[0].users;

// Step dimulai dari 1 (SPA: navigasi step via JS, bukan reload per step)
const step = parseInt(Astro.url.searchParams.get("step") || "1");
if (step < 1 || step > 7) {
  return Astro.redirect("/mahasiswa/form?step=1");
}

// Build stepData per section (semua step) — render SPA tanpa reload per step
let stepData: Record<number, any> = {};
let uploadedFiles: Record<string, { id: string; name: string }> = {};
const allSectionTables = [
  identitasPribadi,
  riwayatPendidikan,
  prestasiTahfidz,
  identitasKeluarga,
  kondisiRumah,
  domisiliOrtu,
  kebutuhanKhusus,
];
let sectionRows: any[] = [];
try {
  sectionRows = await Promise.all(
    allSectionTables.map((t) =>
      db.select().from(t).where(eq(t.userId, user.id)).limit(1),
    ),
  );
} catch (e: any) {
  console.error("SECTION_QUERY_ERR:", e?.message || e);
  sectionRows = allSectionTables.map(() => []);
}
sectionRows.forEach((rows, i) => {
  const N = i + 1;
  if (rows.length > 0) {
    stepData[N] = { ...rows[0] };
    delete stepData[N].id;
    delete stepData[N].userId;
    delete stepData[N].createdAt;
    delete stepData[N].updatedAt;
  } else {
    stepData[N] = {};
  }
});

// Merge users table data as fallback (for step 1 fields)
if (stepData[1] && !stepData[1].nama) stepData[1].nama = user.namaLengkap;
if (stepData[1] && !stepData[1].nik) stepData[1].nik = user.nik;
if (stepData[1] && !stepData[1].nim) stepData[1].nim = user.nim;

// Prestasi list (bisa banyak) — render SEMUA item di step 3, bukan cuma satu.
let prestasiArray: any[] = [];
{
  const raw = stepData[3]?.prestasiList;
  if (raw) {
    try {
      const arr = JSON.parse(raw);
      if (Array.isArray(arr)) prestasiArray = arr;
    } catch {}
  }
  if (prestasiArray.length === 0 && stepData[3]?.namaLomba) {
    prestasiArray = [{
      namaLomba: stepData[3].namaLomba, jenisLomba: stepData[3].jenisLomba,
      tingkatLomba: stepData[3].tingkatLomba, predikatJuara: stepData[3].predikatJuara,
    }];
  }
  if (prestasiArray.length === 0) {
    prestasiArray = [{ namaLomba: "", jenisLomba: "", tingkatLomba: "", predikatJuara: "" }];
  }
}

// Load uploaded files from dokumen table
const docs = await db.select().from(dokumen).where(eq(dokumen.userId, user.id));
for (const doc of docs) {
  if (doc.r2Key) {
    uploadedFiles[doc.fieldName] = {
      id: doc.r2Key,
      name: doc.originalFilename || doc.fieldName,
    };
  }
}

// Determine which sections actually have data (for the stepper check mark).
// A section is "completed" only if it has REAL content. A row can exist with
// all-null values (the save API inserts a row even on an empty "Simpan & Lanjut"
// click), so row-existence alone produces false check marks.
const completedSteps = new Set<number>();
{
  const metaKeys = new Set(["id", "userId", "createdAt", "updatedAt"]);
  sectionRows.forEach((rows, i) => {
    if (rows.length === 0) return;
    const row = rows[0];
    // Mark complete only if at least one data column has meaningful content
    // (non-empty string, or a non-zero number). Metadata keys are excluded.
    const hasContent = Object.entries(row).some(([key, value]) => {
      if (metaKeys.has(key)) return false;
      if (typeof value === "string") return value.trim() !== "";
      if (typeof value === "number") return value !== 0;
      return value !== null && value !== undefined;
    });
    if (hasContent) completedSteps.add(i + 1);
  });
}

// Step config
const steps = [
  { num: 1, label: "Identitas Pribadi", icon: "person" },
  { num: 2, label: "Riwayat Pendidikan", icon: "school" },
  { num: 3, label: "Prestasi & Tahfidz", icon: "emoji_events" },
  { num: 4, label: "Identitas Keluarga", icon: "family_restroom" },
  { num: 5, label: "Kondisi Rumah", icon: "home" },
  { num: 6, label: "Domisili Ortu", icon: "location_on" },
  { num: 7, label: "Kebutuhan Khusus", icon: "accessibility" },
];

const currentStepConfig = steps[step - 1];
---

<MahasiswaLayout
  title={`Form - ${currentStepConfig.label}`}
  namaUser={user.namaLengkap}
>
  <!-- Stepper -->
  <div class="mb-8">
    <div class="flex items-center justify-between max-w-3xl mx-auto">
      {
        steps.map((s, i) => (
          <>
            <a
              href={`/mahasiswa/form?step=${s.num}`}
              data-step-link={s.num}
              class:list={[
                "flex flex-col items-center gap-1 group stepper-item cursor-pointer",
                completedSteps.has(s.num) && s.num !== step
                  ? "text-primary completed"
                  : s.num === step
                    ? "text-primary stepper-active"
                    : "text-outline-variant",
              ]}
            >
              <div
                class:list={[
                  "w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold border-2 transition stepper-dot",
                  s.num === step
                    ? "border-blue-600 bg-primary text-white stepper-active-dot"
                    : completedSteps.has(s.num)
                      ? "border-green-600 bg-primary text-white"
                      : "border-outline-variant border-outline-variant text-outline-variant",
                ]}
              >
                {completedSteps.has(s.num) && s.num !== step ? (
                  <span class="material-symbols-outlined text-lg">check</span>
                ) : (
                  s.num
                )}
              </div>
              <span class="text-xs font-medium hidden sm:block">{s.label}</span>
            </a>
            {i < steps.length - 1 && (
              <div
                class:list={[
                  "flex-1 h-0.5 mx-2",
                  s.num < step ? "bg-primary" : "bg-surface-container-high",
                ]}
              />
            )}
          </>
        ))
      }
    </div>
  </div>

  <!-- Pengecekan Desil DTSEN — petunjuk wajib sebelum melengkapi formulir -->
  <div class="mb-6">
    <div
      class="flex items-start gap-3 p-4 rounded-xl border border-primary/30 bg-primary-container/20"
    >
      <span class="material-symbols-outlined text-primary shrink-0 mt-0.5"
        >info</span
      >
      <div class="flex-1 space-y-1">
        <p class="text-sm font-semibold text-on-surface">
          Cek Desil DTSEN Sebelum Melengkapi Formulir
        </p>
        <p class="text-xs text-on-surface-variant">
          Desil DTSEN menjadi salah satu dasar <span class="font-medium"
            >verifikasi kebenaran data</span
          > dan
          <span class="font-medium">kelayakan penerimaan beasiswa</span>.
          Sebelum mengisi formulir, silakan:
        </p>
        <ol
          class="list-decimal list-inside text-xs text-on-surface-variant space-y-0.5 mt-1"
        >
          <li>
            Lakukan pengecekan desil di
            <a
              href="https://dtsen-form.bps.go.id/indonesia-pintar"
              target="_blank"
              rel="noopener"
              class="text-primary underline font-medium hover:opacity-80"
              >dtsen-form.bps.go.id/indonesia-pintar</a
            >.
          </li>
          <li>
            Jika terdapat <span class="font-medium">kesalahan data</span> pada data
            Anda di BPS, lakukan <span class="font-medium">pembaruan data</span> (update)
            melalui menu yang tersedia di halaman tersebut.
          </li>
          <li>
            Pastikan data yang Anda isi pada formulir ini sesuai dengan data
            terbaru di DTSEN.
          </li>
        </ol>
      </div>
    </div>
  </div>

  <!-- Form Card -->
  <Card title={`Bagian ${step}: ${currentStepConfig.label}`}>
    <form id="form-wizard" class="space-y-6">
      <input type="hidden" name="step" value={step} />

      <!-- Form fields rendered by step -->
      <div id="form-fields">
        <!-- Step 1: Identitas Pribadi -->

        <section data-step="1" data-step-panel class="hidden">
          <div class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  Nama Lengkap <span class="text-error">*</span>
                </label>
                <input
                  type="text"
                  name="nama"
                  value={stepData[1].nama || ""}
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                />
              </div>
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  NIK (KK/KTP) <span class="text-error">*</span>
                </label>
                <input
                  type="text"
                  name="nik"
                  value={stepData[1].nik || ""}
                  maxlength="16"
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                />
              </div>
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  NIM <span class="text-error">*</span>
                </label>
                <input
                  type="text"
                  name="nim"
                  value={stepData[1].nim || user.nim || ""}
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                />
              </div>
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  Tempat Lahir <span class="text-error">*</span>
                </label>
                <input
                  type="text"
                  name="tempat_lahir"
                  value={stepData[1].tempatLahir || ""}
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                />
              </div>
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  Tanggal Lahir <span class="text-error">*</span>
                </label>
                <input
                  type="date"
                  name="tanggal_lahir"
                  value={stepData[1].tanggalLahir || ""}
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                />
              </div>
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  Jenis Kelamin <span class="text-error">*</span>
                </label>
                <select
                  name="jenis_kelamin"
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                >
                  <option value="">Pilih</option>
                  <option value="L" selected={stepData[1].jenisKelamin === "L"}>
                    Laki-laki
                  </option>
                  <option value="P" selected={stepData[1].jenisKelamin === "P"}>
                    Perempuan
                  </option>
                </select>
              </div>
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  Golongan Darah
                 <span class="text-error">*</span></label>
                <select
                  name="golongan_darah"
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                >
                  <option value="">Pilih</option>
                  {
                    ["A", "B", "O", "AB"].map((g) => (
                      <option
                        value={g}
                        selected={stepData[1].golonganDarah === g}
                      >
                        {g}
                      </option>
                    ))
                  }
                </select>
              </div>
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  Agama <span class="text-error">*</span>
                </label>
                <select
                  name="agama"
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                >
                  <option value="">Pilih</option>
                  {
                    [
                      "Islam",
                      "Kristen",
                      "Katolik",
                      "Hindu",
                      "Buddha",
                      "Konghucu",
                    ].map((a) => (
                      <option value={a} selected={stepData[1].agama === a}>
                        {a}
                      </option>
                    ))
                  }
                </select>
              </div>
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  No Whatsapp<span class="text-error">*</span>
                </label>
                <input
                  type="tel"
                  name="no_hp"
                  value={stepData[1].noHp || ""}
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                />
              </div>
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  Email <span class="text-error">*</span>
                </label>
                <input
                  type="email"
                  name="email"
                  value={stepData[1].email &&
                  stepData[1].email.indexOf("@blank.local") === -1 &&
                  stepData[1].email.indexOf("@beasiswa.iainptk.ac.id") === -1
                    ? stepData[1].email
                    : ""}
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                />
              </div>
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  Anak ke-
                 <span class="text-error">*</span></label>
                <input
                  type="number"
                  name="anak_ke"
                  value={stepData[1].anakKe || ""}
                  min="1"
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                />
              </div>
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  Jumlah Saudara
                 <span class="text-error">*</span></label>
                <input
                  type="number"
                  name="jumlah_saudara"
                  value={stepData[1].jumlahSaudara || ""}
                  min="0"
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                />
              </div>
            </div>

            <h3
              class="text-lg font-semibold text-on-surface pt-4 border-t border-outline-variant"
            >
              Alamat
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  Provinsi <span class="text-error">*</span>
                </label>
                <input
                  type="text"
                  name="provinsi"
                  value={stepData[1].provinsi || ""}
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                />
              </div>
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  Kabupaten / Kota
                 <span class="text-error">*</span></label>
                <input
                  type="text"
                  name="kabupaten"
                  value={stepData[1].kabupaten || ""}
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                />
              </div>
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  Kecamatan
                 <span class="text-error">*</span></label>
                <input
                  type="text"
                  name="kecamatan"
                  value={stepData[1].kecamatan || ""}
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                />
              </div>
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  Kelurahan / Desa
                 <span class="text-error">*</span></label>
                <input
                  type="text"
                  name="kelurahan"
                  value={stepData[1].kelurahan || ""}
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                />
              </div>
              <div class="md:col-span-2">
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  Alamat (Jln, Gg, No Rumah)
                 <span class="text-error">*</span></label>
                <textarea
                  name="alamat"
                  rows="2"
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                  >{stepData[1].alamat || ""}</textarea
                >
              </div>
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  RT / RW
                 <span class="text-error">*</span></label>
                <input
                  type="text"
                  name="rt_rw"
                  value={stepData[1].rtRw || ""}
                  placeholder="001/002"
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                />
              </div>
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  Kode Pos
                 <span class="text-error">*</span></label>
                <input
                  type="text"
                  name="kode_pos"
                  value={stepData[1].kodePos || ""}
                  maxlength="5"
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                />
              </div>
            </div>

            <h3
              class="text-lg font-semibold text-on-surface pt-4 border-t border-outline-variant"
            >
              No. KIP (Waktu SMA/Sederajat) / PKH / KJP / Desil
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  Nomor KIP / PIP / KJP (Waktu SMA/Sederajat)
                 <span class="text-error">*</span></label>
                <input
                  type="text"
                  name="no_kip"
                  value={stepData[1].noKip || ""}
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                />
              </div>
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  Nomor Desil
                 <span class="text-error">*</span></label>
                <input
                  type="text"
                  name="no_desil"
                  value={stepData[1].noDesil || ""}
                  placeholder="1-10"
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                />
              </div>
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  Penerima PKH
                </label>
                <select
                  name="penerima_pkh"
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                >
                  <option value="0" selected={!stepData[1].penerimaPkh}>
                    Tidak
                  </option>
                  <option value="1" selected={stepData[1].penerimaPkh === 1}>
                    Ya
                  </option>
                </select>
              </div>
              <div>
                <label
                  class="block text-sm font-medium text-on-surface-variant mb-1.5"
                >
                  Penerima KJP
                </label>
                <select
                  name="penerima_kjp"
                  class="w-full px-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:ring-2 focus:ring-primary outline-none"
                >
                  <option value="0" selected={!stepData[1].penerimaKjp}>
                    Tidak
                  </option>
                  <option value="1" selected={stepData[1].penerimaKjp === 1}>
                    Ya
                  </option>
                </select>
              </div>
            </div>

            <h3
              class="text-lg font-semibold text-on-surface pt-4 border-t border-outline-variant"
            >
              Dokumen Pendukung
            </h3>
            <p class="text-xs text-outline mb-2">
              ⚠️ Jika No. KIP diisi, unggah Kartu KIP/PIP/KJP menjadi wajib.
              KKS, SKTM, atau SK Penghasilan Ortu — minimal salah satu wajib
              diunggah. Admin akan memverifikasi kelengkapan berkas Anda.
            </p>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
              <FileUploadBox
                id="foto_formal"
                label="Pas Foto 3x4 Berwarna"
                bagian="identitas_pribadi"
                fieldName="foto_formal"
                accept=".jpg,.jpeg,.png"
