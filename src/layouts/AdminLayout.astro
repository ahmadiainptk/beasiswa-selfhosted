---
// path: src/layouts/AdminLayout.astro
// Layout admin panel: sidebar kiri + header + konten — MD3 style
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  namaUser?: string;
  activeMenu?: string;
  userRole?: string;
}

const {
  title,
  namaUser = "Admin",
  activeMenu = "",
  userRole = "superadmin",
} = Astro.props;

const allMenus = [
  { href: "/admin", icon: "dashboard", label: "Dashboard", id: "dashboard", roles: ["admin", "superadmin", "editor"] },
  { href: "/admin/pendaftaran", icon: "group", label: "Profil Mahasiswa", id: "pendaftaran", roles: ["admin", "superadmin"] },
  { href: "/admin/pendaftaran-beasiswa", icon: "how_to_reg", label: "Pendaftar Beasiswa", id: "pendaftaran-beasiswa", roles: ["admin", "superadmin"] },
  { href: "/admin/beasiswa", icon: "workspace_premium", label: "Beasiswa", id: "beasiswa", roles: ["superadmin"] },
  { href: "/admin/pengumuman", icon: "campaign", label: "Pengumuman", id: "pengumuman", roles: ["superadmin"] },
  { href: "/admin/blog", icon: "article", label: "Blog/Berita", id: "blog", roles: ["editor", "superadmin"] },
  { href: "/admin/export", icon: "download", label: "Export Data", id: "export", roles: ["admin", "superadmin"] },
  { href: "/admin/pengaturan", icon: "settings", label: "Pengaturan", id: "pengaturan", roles: ["superadmin"] },
  { href: "/admin/profil", icon: "person", label: "Profil Saya", id: "profil", roles: ["admin", "superadmin", "editor"] },
];

const menus = allMenus.filter((m) => m.roles.includes(userRole));
---

<BaseLayout title={title}>
  <div class="flex min-h-screen">
    <!-- Sidebar (desktop) -->
    <aside class="w-64 bg-surface-container-lowest border-r border-outline-variant hidden lg:flex lg:flex-col lg:fixed lg:inset-y-0">
      <div class="p-5 flex flex-col h-full">
        <!-- Logo -->
        <a href="/admin" class="flex items-center gap-3 mb-8 shrink-0">
          <span class="material-symbols-outlined text-primary text-[32px]">account_balance</span>
          <div>
            <h2 class="font-bold font-[Montserrat] text-primary text-sm">Admin Panel</h2>
            <p class="text-[11px] text-outline">Beasiswa IAIN Pontianak</p>
          </div>
        </a>

        <!-- Navigation -->
        <nav class="space-y-1 flex-1">
          {menus.map((menu) => (
            <a href={menu.href}
              class:list={[
                "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-semibold tracking-wider transition",
                activeMenu === menu.id
                  ? "bg-secondary-container text-on-secondary-container rounded-full"
                  : "text-on-surface-variant hover:bg-surface-container-high",
              ]}
            >
              <span class="material-symbols-outlined text-xl">{menu.icon}</span>
              {menu.label}
            </a>
          ))}
        </nav>

        <!-- Sidebar Footer -->
        <div class="pt-4 border-t border-outline-variant mt-4">
          <p class="text-[10px] text-outline">&copy; {new Date().getFullYear()} IAIN Pontianak</p>
        </div>
      </div>
    </aside>

    <!-- Main Area -->
    <div class="flex-1 flex flex-col lg:ml-64">
      <!-- Header -->
      <header class="sticky top-0 z-50 bg-surface/95 backdrop-blur-md border-b border-outline-variant">
        <div class="flex items-center justify-between h-14 px-4 lg:px-6">
          <!-- Mobile menu toggle + breadcrumb -->
          <div class="flex items-center gap-3">
            <button id="mobile-menu-btn" class="lg:hidden p-1.5 rounded-lg hover:bg-surface-container-high transition">
              <span class="material-symbols-outlined text-xl text-primary">menu</span>
            </button>
            <h1 class="text-sm font-semibold tracking-wider text-on-surface hidden sm:block">{title}</h1>
          </div>

          <!-- User Menu -->
          <div class="relative" id="user-menu">
            <button id="user-menu-btn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-semibold tracking-wider text-on-surface-variant hover:bg-surface-container-high transition">
              <span class="material-symbols-outlined text-lg">account_circle</span>
              <span class="hidden sm:inline">{namaUser}</span>
              <span class="material-symbols-outlined text-base">expand_more</span>
            </button>
            <div id="user-dropdown" class="hidden absolute right-0 mt-1.5 w-48 bg-surface-container-lowest rounded-xl shadow-lg border border-outline-variant py-1.5 z-50">
              <a href="/admin/profil" class="w-full text-left px-4 py-2 text-sm text-on-surface hover:bg-surface-container-high flex items-center gap-2 transition">
                <span class="material-symbols-outlined text-lg">person</span>
                Profil Saya
              </a>
              <button id="logout-btn" class="w-full text-left px-4 py-2 text-sm text-error hover:bg-error-container flex items-center gap-2 transition">
                <span class="material-symbols-outlined text-lg">logout</span>
                Keluar
              </button>
            </div>
          </div>
        </div>
      </header>

      <!-- Mobile Sidebar Overlay -->
      <div id="mobile-overlay" class="hidden fixed inset-0 bg-black/50 z-40 lg:hidden"></div>
      <div id="mobile-sidebar" class="fixed inset-y-0 left-0 w-64 bg-surface-container-lowest border-r border-outline-variant z-50 transform -translate-x-full transition-transform lg:hidden">
        <div class="p-5">
          <a href="/admin" class="flex items-center gap-3 mb-8">
            <span class="material-symbols-outlined text-primary text-[32px]">account_balance</span>
            <div>
              <h2 class="font-bold font-[Montserrat] text-primary text-sm">Admin Panel</h2>
              <p class="text-[11px] text-outline">Beasiswa IAIN Pontianak</p>
            </div>
          </a>
          <nav class="space-y-1">
            {menus.map((menu) => (
              <a href={menu.href}
                class:list={[
                  "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-semibold tracking-wider transition",
                  activeMenu === menu.id
                    ? "bg-secondary-container text-on-secondary-container rounded-full"
                    : "text-on-surface-variant hover:bg-surface-container-high",
                ]}
              >
                <span class="material-symbols-outlined text-xl">{menu.icon}</span>
                {menu.label}
              </a>
            ))}
          </nav>
        </div>
      </div>

      <!-- Page Content -->
      <main class="flex-1 p-4 lg:p-6 bg-surface">
        <slot />
      </main>
    </div>
  </div>

  <script>
    // User dropdown
    (function() {
      const menuBtn = document.getElementById("user-menu-btn")!;
      const dropdown = document.getElementById("user-dropdown")!;
      menuBtn.addEventListener("click", () => dropdown.classList.toggle("hidden"));
      document.addEventListener("click", (e) => {
        if (!menuBtn.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
          dropdown.classList.add("hidden");
        }
      });
      document.getElementById("logout-btn")!.addEventListener("click", async () => {
        try { await fetch("/api/auth/logout", { method: "POST" }); } catch (_) {}
        window.location.href = "/login";
      });
    })();

    // Mobile sidebar
    (function() {
      const btn = document.getElementById("mobile-menu-btn")!;
      const overlay = document.getElementById("mobile-overlay")!;
      const sidebar = document.getElementById("mobile-sidebar")!;
      btn.addEventListener("click", () => {
        overlay.classList.remove("hidden");
        sidebar.classList.remove("-translate-x-full");
      });
      overlay.addEventListener("click", () => {
        overlay.classList.add("hidden");
        sidebar.classList.add("-translate-x-full");
      });
    })();
  </script>
</BaseLayout>
